# .env.example
# 日志级别；运行前导出为环境变量，程序不会自动读取此文件。
LOG_LEVEL=INFO

# 本地模型服务地址；通过 SSH 隧道访问时填写本机转发地址。
# OLLAMA_BASE_URL=http://127.0.0.1:21435
VLM_MODEL=qwen3.5:9b
AGENT_MODEL=qwen3.5:9b

# 独立机器人演示使用的适配器；未知设备拒绝启动。
ROBOT_ADAPTER=simulated

# off 仅文字；simulated 通过 Runtime 模拟播报，不输出真实声音。
ROBOT_AUDIO=off

# 真实语音客户端：uv sync --extra speech-client；本地不需要 ASR 模型或 TTS 引擎。
# 设备可填枚举编号或名称，留空使用当前系统默认设备。
SPEECH_INPUT_DEVICE=
SPEECH_OUTPUT_DEVICE=
SPEECH_SAMPLE_RATE=16000
SPEECH_MAX_DURATION_S=15
SPEECH_TIMEOUT_S=60
# 必填：服务器 SSH 地址和远端安装目录；使用现有 SSH 认证，不在此填写密码。
SPEECH_SSH_HOST=
SPEECH_SSH_PORT=22
SPEECH_SSH_USER=
SPEECH_SERVER_DIRECTORY=
SPEECH_ASR_LANGUAGE=zh
SPEECH_TTS_VOICE=huayan
# 以下只在服务器环境设置；默认相对服务器安装目录。
# SPEECH_ASR_MODEL_PATH=models/whisper-base
# SPEECH_ASR_DEVICE=cpu
# SPEECH_ASR_COMPUTE_TYPE=int8
# SPEECH_TTS_MODEL_PATH=models/piper/zh_CN-huayan-medium.onnx
