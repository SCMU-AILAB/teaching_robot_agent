# .env.example
# 日志级别；运行前导出为环境变量，程序不会自动读取此文件。
LOG_LEVEL=INFO

# 本地模型服务地址；通过 SSH 隧道访问时填写本机转发地址。
# OLLAMA_BASE_URL=http://127.0.0.1:21435
VLM_MODEL=qwen3.5:9b
AGENT_MODEL=qwen3.5:9b

# 独立机器人演示使用的适配器；未知设备拒绝启动。
ROBOT_ADAPTER=simulated

# off 仅文字；simulated 通过 Runtime 模拟播报，不输出真实声音。
ROBOT_AUDIO=off

# 真实语音独立入口；先 uv sync --extra speech，并下载离线模型。
# 设备可填枚举编号或名称，留空使用当前系统默认设备。
SPEECH_INPUT_DEVICE=
SPEECH_OUTPUT_DEVICE=
SPEECH_SAMPLE_RATE=16000
SPEECH_MAX_DURATION_S=15
SPEECH_TIMEOUT_S=60
# 必填：下载后的本地 Whisper 模型目录，不填服务器密码或服务 URL。
SPEECH_ASR_MODEL_PATH=
SPEECH_ASR_LANGUAGE=zh
SPEECH_ASR_DEVICE=cpu
SPEECH_ASR_COMPUTE_TYPE=int8
# macOS 使用 say/Tingting；Linux 可改为 espeak-ng/cmn。
SPEECH_TTS_ENGINE=say
SPEECH_TTS_VOICE=Tingting

# 感知演示入口使用的相机；未知来源拒绝启动。
PERCEPTION_CAMERA=file
# file 模式读取的图片路径。
PERCEPTION_IMAGE=/path/to/photo.png
# usb 模式的设备号。
PERCEPTION_DEVICE=0
