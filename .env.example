# .env.example
# 日志级别；运行前导出为环境变量，程序不会自动读取此文件。
LOG_LEVEL=INFO

# 本地模型服务地址；通过 SSH 隧道访问时填写本机转发地址。
# OLLAMA_BASE_URL=http://127.0.0.1:21435
VLM_MODEL=qwen3.5:9b
# 模型在 Ollama 中的常驻时长，默认 30m；显存紧张时调短。
OLLAMA_KEEP_ALIVE=30m
AGENT_MODEL=qwen3.5:9b

# 后端 HTTP API（uv run python -m app.robot_server）；默认只监听本机，
# 局域网部署设为 Jetson 局域网地址或 0.0.0.0，不得暴露到公网。
ROBOT_API_HOST=127.0.0.1
ROBOT_API_PORT=8000

# 独立机器人演示使用的适配器：simulated 或 car（麦克纳姆底盘，需 uv sync --extra car）；未知设备拒绝启动。
ROBOT_ADAPTER=simulated

# ROBOT_ADAPTER=car 时必填串口；里程计常数由 app.car_calibrate 实测，缺少时底盘只连接、不开放运动技能。
# CAR_SERIAL_PORT=/dev/ttyUSB0
# CAR_COUNTS_PER_METER=
# CAR_COUNTS_PER_RADIAN=
# CAR_COUNTS_PER_METER_LATERAL=
# 单轴速度千分比上限（1000 = 每轮 4000 计数/秒）与相对运动验收容差。
# CAR_MAX_PERMILLE=600
# CAR_POSITION_TOLERANCE_M=0.02
# CAR_YAW_TOLERANCE_RAD=0.035

# off 仅文字；simulated 通过 Runtime 模拟播报，不输出真实声音；
# real 使用本机麦克风、进程内常驻识别、系统合成与扬声器（需 uv sync --extra speech）。
ROBOT_AUDIO=off

# 主控制台的感知来源；live 使用真实相机与本地视觉模型，未知值拒绝启动。
ROBOT_PERCEPTION=simulated

# ROBOT_AUDIO=real 时必填：本机已下载的识别模型目录，应用启动时加载一次。
# 默认引擎 sensevoice 需 model.int8.onnx 与 tokens.txt；whisper 需 model.bin。
# SPEECH_ASR_ENGINE=sensevoice
# SPEECH_ASR_MODEL_PATH=models/sensevoice-small
# 仅 whisper 引擎使用：
# SPEECH_ASR_DEVICE=cpu
# SPEECH_ASR_COMPUTE_TYPE=int8
# 本机系统合成：macOS 为 say/Tingting，Linux 为 espeak-ng/cmn。
# SPEECH_TTS_ENGINE=say
# SPEECH_SYSTEM_TTS_VOICE=Tingting
# GPT-SoVITS 训练音色：服务运行在 3080（sovits-api.service），只监听 127.0.0.1:9881，
# Jetson 与开发机都经 SSH 隧道访问（Jetson 部署见 deploy/jetson/）。参考音频路径指 3080 上的路径，原文须与参考音频一致。
# 服务需设置 TORCH_CUDNN_V8_API_DISABLED=1：PyTorch 2.10/2.11 + cuDNN 9 新接口下单句合成会慢到一分钟以上。
# SPEECH_TTS_ENGINE=gpt-sovits
# SPEECH_GPTSOVITS_URL=http://127.0.0.1:29881
# SPEECH_GPTSOVITS_REF_AUDIO=/home/yaoyifeng/opt-sovits/ref/cf_ref.wav
# SPEECH_GPTSOVITS_PROMPT_TEXT=秦孝公据崤函之固,拥雍州之地,君臣固守矣.
# SPEECH_GPTSOVITS_PROMPT_LANG=zh
# SPEECH_GPTSOVITS_SPEED=1.0

# 真实语音客户端：uv sync --extra speech-client；本地不需要 ASR 模型或 TTS 引擎。
# 设备必须填名称（支持子串、忽略大小写），不要填枚举序号：序号随拔插变化。
# 名称找不到或有多个同名设备时启动报错，不会静默退回系统默认设备。
# 枚举设备：uv run --extra speech-client python -m providers.audio.worker devices
SPEECH_INPUT_DEVICE=
SPEECH_OUTPUT_DEVICE=
SPEECH_SAMPLE_RATE=16000
SPEECH_MAX_DURATION_S=15
SPEECH_TIMEOUT_S=60
# 必填：服务器 SSH 地址和远端安装目录；使用现有 SSH 认证，不在此填写密码。
SPEECH_SSH_HOST=
SPEECH_SSH_PORT=22
SPEECH_SSH_USER=
SPEECH_SERVER_DIRECTORY=
SPEECH_ASR_LANGUAGE=zh
SPEECH_TTS_VOICE=huayan
# 以下只在服务器环境设置；默认相对服务器安装目录（与上方本机常驻识别互不影响）。
# SPEECH_ASR_MODEL_PATH=models/whisper-base
# SPEECH_ASR_DEVICE=cpu
# SPEECH_ASR_COMPUTE_TYPE=int8
# SPEECH_TTS_MODEL_PATH=models/piper/zh_CN-huayan-medium.onnx

# 感知演示入口使用的相机；未知来源拒绝启动。
PERCEPTION_CAMERA=file
# file 模式读取的图片路径。
PERCEPTION_IMAGE=/path/to/photo.png
# usb 模式的设备号。
PERCEPTION_DEVICE=0
