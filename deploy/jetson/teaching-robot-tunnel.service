# deploy/jetson/teaching-robot-tunnel.service
# Jetson → 3080 的 SSH 隧道：Ollama 与 GPT-SoVITS 都只监听 3080 本机，不开放到局域网。
# 用户级服务：复制到 ~/.config/systemd/user/ 后 systemctl --user enable --now。

[Unit]
Description=Teaching robot SSH tunnel to the 3080 model server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/teaching-robot/robot.env
# 转发失败立即退出由 systemd 重启；保活探测在网络中断约 45 秒内发现断线。
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
    -L 127.0.0.1:21435:127.0.0.1:11435 -L 127.0.0.1:29881:127.0.0.1:9881 \
    ${MODEL_SERVER_SSH}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
