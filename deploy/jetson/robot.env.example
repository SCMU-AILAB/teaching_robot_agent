# deploy/jetson/robot.env.example
# Jetson 机器人后端配置；复制为 ~/teaching-robot/robot.env 后按实际修改（不提交仓库）。
# 由 systemd 的 EnvironmentFile 读取，手动调试时用 bash source：每行 KEY=VALUE，不写 export；
# 含空格的值用双引号包起来，两者都能识别。

LOG_LEVEL=INFO

# ---------- 3080 模型服务（经 SSH 隧道，见 teaching-robot-tunnel.service） ----------
# 隧道目标：3080 的 SSH 登录，须事先配置免密钥登录；不在此填写密码。
MODEL_SERVER_SSH=yaoyifeng@192.168.0.239
# Ollama 在 3080 上只监听 127.0.0.1:11435，经隧道转为 Jetson 本机 21435。
OLLAMA_BASE_URL=http://127.0.0.1:21435
AGENT_MODEL=qwen3.5:9b
VLM_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=30m

# ---------- HTTP API（前端连这里） ----------
# 只在受控局域网开放，不得映射到公网。端口与前端默认一致。
ROBOT_API_HOST=0.0.0.0
ROBOT_API_PORT=8090

# ---------- 底盘 ----------
# 标定前可先用 simulated 联调；接车后改为 car。
ROBOT_ADAPTER=car
CAR_SERIAL_PORT=/dev/ttyUSB0
# 由 app.car_calibrate 实测后填写；缺少时底盘只连接、不开放运动技能。
CAR_COUNTS_PER_METER=
CAR_COUNTS_PER_RADIAN=

# ---------- 摄像头与视觉 ----------
ROBOT_PERCEPTION=live
PERCEPTION_CAMERA=usb
PERCEPTION_DEVICE=0

# ---------- 语音 ----------
ROBOT_AUDIO=real
# 设备按名称匹配（子串、忽略大小写），不要填序号。
# 枚举：.venv/bin/python -m providers.audio.worker devices
SPEECH_INPUT_DEVICE=Earpods
SPEECH_OUTPUT_DEVICE="USB Audio Device"
SPEECH_SAMPLE_RATE=16000
SPEECH_MAX_DURATION_S=15
SPEECH_TIMEOUT_S=30
# 识别：SenseVoice 在 Jetson CPU 上常驻，模型目录相对仓库根目录。
SPEECH_ASR_ENGINE=sensevoice
SPEECH_ASR_MODEL_PATH=models/sensevoice-small
SPEECH_ASR_LANGUAGE=zh
# 合成：3080 上的 GPT-SoVITS 只监听 127.0.0.1:9881，经隧道转为 Jetson 本机 29881。
# 参考音频路径是 3080 上的路径，原文须与参考音频一致。
SPEECH_TTS_ENGINE=gpt-sovits
SPEECH_GPTSOVITS_URL=http://127.0.0.1:29881
SPEECH_GPTSOVITS_REF_AUDIO=/home/yaoyifeng/opt-sovits/ref/cf_ref.wav
SPEECH_GPTSOVITS_PROMPT_TEXT=秦孝公据崤函之固,拥雍州之地,君臣固守矣.
SPEECH_GPTSOVITS_PROMPT_LANG=zh
