# deploy/docker/backend.env.example
# Docker 部署配置；复制为 deploy/docker/backend.env 后修改（不提交仓库）。
# 每行 KEY=VALUE，不写 export。接真车时改用 deploy/jetson/robot.env.example 的完整配置。

LOG_LEVEL=INFO

# 必填：Ollama 地址。宿主机上的 Ollama 用 host.docker.internal；
# 真车模式（host 网络）经隧道为 http://127.0.0.1:21435。
OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_MODEL=qwen3.5:9b
VLM_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=30m
AGENT_ANSWER_CHARS=40

# 模拟底盘、模拟感知、模拟播报：不需要任何设备即可走通文字对话
ROBOT_ADAPTER=simulated
ROBOT_PERCEPTION=simulated
ROBOT_AUDIO=simulated
DEPTH_CAMERA=off
